@{
    ViewData["Title"] = "Forgot Password - Retailer Recovery";
}

<div class="row justify-content-center py-4">
    <div class="col-md-5">
        <div class="ge-card shadow-sm p-4">
            <h4 class="fw-bold text-dark mb-2"><i class="bi bi-shield-lock text-primary me-2"></i>Reset Retailer Password</h4>
            <p class="text-muted small">Enter your registered email address or mobile number to receive your temporary verification code.</p>

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success small mb-3">
                    <i class="bi bi-check-circle-fill me-1"></i> @ViewBag.Success
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Registered Email or Phone</label>
                    <input type="text" name="emailOrPhone" class="form-control" placeholder="e.g. om.retail@gmail.com or 9820112233" required />
                </div>

                <div class="p-3 bg-light rounded border small text-muted mb-3">
                    <strong>Quick Test Note:</strong> All registered dummy retailers have their password defaulted to <code>Password@123</code>. You can also log in directly using the <strong>OTP Login</strong> tab with demo code <code>123456</code>.
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="RetailerLogin" class="btn btn-outline-secondary btn-sm">
                        &larr; Back to Login
                    </a>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold">
                        Send Recovery PIN
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

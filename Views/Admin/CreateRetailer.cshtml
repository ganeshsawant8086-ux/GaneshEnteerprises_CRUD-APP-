@model GaneshEnterprises.Models.Retailer
@{
    ViewData["Title"] = "Admin - Register New Retailer";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="mb-4">
            <a asp-action="Retailers" class="btn btn-outline-secondary btn-sm mb-2">&larr; Back to Retailers Directory</a>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-person-plus text-success me-2"></i>Register New Retailer Partner</h2>
            <p class="text-muted small">Create an authorized wholesale dealer account with login credentials.</p>
        </div>

        <div class="ge-card shadow-sm">
            <div class="ge-card-header bg-light">
                <h5 class="mb-0 fw-bold text-dark">Retailer Partner Profile &amp; Login Setup</h5>
            </div>
            <div class="ge-card-body p-4">
                <form asp-action="CreateRetailer" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="BusinessName" class="form-label fw-bold"></label>
                            <input asp-for="BusinessName" class="form-control" placeholder="e.g. Mahavir Plastic Stores" />
                            <span asp-validation-for="BusinessName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="OwnerName" class="form-label fw-bold"></label>
                            <input asp-for="OwnerName" class="form-control" placeholder="e.g. Mohan Lal" />
                            <span asp-validation-for="OwnerName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" placeholder="mahavir.plastic@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="9812345678" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold">Initial Retailer Password</label>
                            <input asp-for="Password" class="form-control" value="Password@123" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <small class="text-muted">Standard Default: <code>Password@123</code></small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GstNumber" class="form-label fw-bold"></label>
                            <input asp-for="GstNumber" class="form-control" placeholder="27AAECG8754P1ZV" />
                            <span asp-validation-for="GstNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-5">
                            <label asp-for="City" class="form-label fw-bold"></label>
                            <input asp-for="City" class="form-control" placeholder="e.g. Nagpur" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="State" class="form-label fw-bold"></label>
                            <input asp-for="State" class="form-control" placeholder="e.g. Maharashtra" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Pincode" class="form-label fw-bold"></label>
                            <input asp-for="Pincode" class="form-control" placeholder="440001" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Retailers" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i> Register Retailer Partner
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

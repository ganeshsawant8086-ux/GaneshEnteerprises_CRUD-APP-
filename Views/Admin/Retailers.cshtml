@model IEnumerable<GaneshEnterprises.Models.Retailer>
@{
    ViewData["Title"] = "Admin - Manage Retailers";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-1">&larr; Back to Admin Dashboard</a>
        <h2 class="fw-bold text-dark mb-0"><i class="bi bi-shop text-success me-2"></i>Manage Retailers Directory</h2>
        <p class="text-muted small mb-0">Manage 10 registered wholesale dealers, credentials, and business status.</p>
    </div>
    <a asp-action="CreateRetailer" class="btn btn-success fw-bold">
        <i class="bi bi-person-plus-fill me-1"></i> Register New Retailer
    </a>
</div>

<div class="ge-card">
    <div class="ge-card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">Authorized Retailer Partners</h5>
        <span class="badge bg-success">@Model.Count() Wholesale Accounts</span>
    </div>
    <div class="table-responsive">
        <table class="ge-table table-hover">
            <thead>
                <tr>
                    <th>Store / Business</th>
                    <th>Contact Person</th>
                    <th>Login Credentials</th>
                    <th>Location</th>
                    <th>GSTIN</th>
                    <th>Orders</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ret in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@ret.BusinessName</div>
                            <small class="text-muted"><i class="bi bi-telephone me-1"></i>@ret.Phone</small>
                        </td>
                        <td>
                            <strong>@ret.OwnerName</strong>
                        </td>
                        <td>
                            <div class="small text-primary"><i class="bi bi-envelope me-1"></i>@ret.Email</div>
                            <div class="small text-muted font-monospace">Pass: <code>@ret.Password</code></div>
                        </td>
                        <td>
                            <div>@ret.City, @ret.State</div>
                            <small class="text-muted">PIN: @ret.Pincode</small>
                        </td>
                        <td>
                            <code>@(string.IsNullOrEmpty(ret.GstNumber) ? "N/A" : ret.GstNumber)</code>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@ret.Orders.Count Orders</span>
                        </td>
                        <td>
                            @if (ret.IsActive)
                            {
                                <span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i> Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger text-white"><i class="bi bi-dash-circle me-1"></i> Disabled</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleRetailerStatus" asp-route-id="@ret.Id" method="post" class="d-inline">
                                @if (ret.IsActive)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate Retailer">
                                        <i class="bi bi-pause-circle"></i> Deactivate
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activate Retailer">
                                        <i class="bi bi-play-circle"></i> Activate
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

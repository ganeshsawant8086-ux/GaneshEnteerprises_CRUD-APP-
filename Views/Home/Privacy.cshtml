@{
    ViewData["Title"] = "Privacy & Commercial Terms";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="ge-card p-4">
            <h2 class="fw-bold text-dark mb-3"><i class="bi bi-shield-check text-primary me-2"></i>Privacy &amp; Business Terms</h2>
            <p class="lead text-secondary">Policies and operational commitments of Ganesh Enterprises.</p>

            <div class="mb-4">
                <h5 class="fw-bold text-dark">Customer Data Privacy</h5>
                <p class="text-muted">
                    Ganesh Enterprises stores customer procurement data, contact telephone numbers, and order requirements solely to fulfill supply orders, provide delivery confirmations, and manage invoicing.
                </p>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold text-dark">Product Quality &amp; Bag Standards</h5>
                <p class="text-muted">
                    All plastic bags supplied by Ganesh Enterprises in <strong>Small</strong>, <strong>Medium</strong>, and <strong>Large</strong> sizes conform to standardized thickness (microns/gauge) and weight-bearing ratings.
                </p>
            </div>

            <div class="p-3 bg-light rounded-3 border">
                <h6 class="fw-bold mb-1"><i class="bi bi-info-circle text-info me-1"></i>Contact &amp; Support</h6>
                <p class="small text-muted mb-0">
                    For inquiries regarding bulk orders, custom printing, or quality verifications, please refer to the business contact details provided in the site footer.
                </p>
            </div>
        </div>
    </div>
</div>

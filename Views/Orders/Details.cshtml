@model GaneshEnterprises.Models.Order

@{
    ViewData["Title"] = "Order Details #" + Model.Id;
    var totalAmount = Model.Product != null ? Model.Product.Price * Model.Quantity : 0;
    var isAdmin = User.IsInRole("Admin");
    var isRetailer = User.IsInRole("Retailer");
    var isCustomer = User.IsInRole("Customer");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            @if (isAdmin)
            {
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to All Orders
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm fw-semibold">
                        <i class="bi bi-pencil-square me-1"></i> Edit Order
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm fw-semibold">
                        <i class="bi bi-trash3 me-1"></i> Delete Order
                    </a>
                </div>
            }
            else if (isRetailer)
            {
                <a asp-controller="RetailerPortal" asp-action="Index" class="btn btn-outline-warning text-dark fw-bold btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Retailer Portal
                </a>
                <a asp-controller="RetailerPortal" asp-action="PlaceOrder" class="btn btn-warning fw-bold btn-sm text-dark">
                    <i class="bi bi-cart-plus me-1"></i> Place Bulk Order
                </a>
            }
            else if (isCustomer)
            {
                <a asp-action="MyOrders" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to My Orders
                </a>
                <a asp-action="Create" class="btn btn-primary btn-sm fw-semibold">
                    <i class="bi bi-cart-plus me-1"></i> Place Another Order
                </a>
            }
            else
            {
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Products
                </a>
            }
        </div>

        <!-- Receipt / Order Slip Card -->
        <div class="ge-card mb-4 shadow-sm border-0">
            <div class="ge-card-header bg-light d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-receipt text-primary me-2"></i>Order Slip #@Model.Id</h5>
                    <small class="text-muted">Recorded on @Model.OrderDate.ToString("dddd, dd MMMM yyyy")</small>
                </div>
                <div>
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge-status-pending fs-6">Pending Approval</span>
                    }
                    else if (Model.Status == "Processing")
                    {
                        <span class="badge-status-processing fs-6">In Production / Processing</span>
                    }
                    else if (Model.Status == "Completed" || Model.Status == "Delivered")
                    {
                        <span class="badge-status-completed fs-6">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge-status-cancelled fs-6">@Model.Status</span>
                    }
                </div>
            </div>

            <div class="ge-card-body p-4">
                <!-- Customer Details -->
                <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
                    <div class="col-sm-6">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-1">Customer / Business Name</label>
                        <h5 class="fw-bold text-dark mb-0">@Model.CustomerName</h5>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-1">Contact Phone Number</label>
                        <div class="fs-6 fw-semibold text-primary">
                            <i class="bi bi-telephone me-1"></i>@Model.ContactNumber
                        </div>
                    </div>
                </div>

                <!-- Product Specifications -->
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bag-check text-accent me-2"></i>Ordered Products / Bag Items</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Item Description</th>
                                <th class="text-center">Bag Size</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderItems != null && Model.OrderItems.Any())
                            {
                                foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <strong class="text-dark">@item.ProductName</strong>
                                        </td>
                                        <td class="text-center">
                                            @if (item.BagSize == "Small")
                                            {
                                                <span class="badge-bag-small">Small</span>
                                            }
                                            else if (item.BagSize == "Large")
                                            {
                                                <span class="badge-bag-large">Large</span>
                                            }
                                            else
                                            {
                                                <span class="badge-bag-medium">@item.BagSize</span>
                                            }
                                        </td>
                                        <td class="text-end fw-semibold">₹@item.UnitPrice.ToString("F2")</td>
                                        <td class="text-center fw-bold">@item.Quantity.ToString("N0") pcs</td>
                                        <td class="text-end fw-bold text-success fs-6">₹@item.TotalPrice.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>
                                        @if (Model.Product != null)
                                        {
                                            <strong>@Model.Product.Name</strong>
                                            <p class="small text-muted mb-0">@Model.Product.Description</p>
                                        }
                                        else
                                        {
                                            <span>Product ID: @Model.ProductId</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (Model.Product != null)
                                        {
                                            @if (Model.Product.BagSize == GaneshEnterprises.Models.BagSize.Small)
                                            {
                                                <span class="badge-bag-small">Small</span>
                                            }
                                            else if (Model.Product.BagSize == GaneshEnterprises.Models.BagSize.Medium)
                                            {
                                                <span class="badge-bag-medium">Medium</span>
                                            }
                                            else
                                            {
                                                <span class="badge-bag-large">Large</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">
                                        ₹@((Model.Product?.Price ?? 0).ToString("F2"))
                                    </td>
                                    <td class="text-center fw-bold">
                                        @Model.Quantity.ToString("N0") pcs
                                    </td>
                                    <td class="text-end fw-bold text-success fs-6">
                                        ₹@((Model.TotalAmount > 0 ? Model.TotalAmount : totalAmount).ToString("N2"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="4" class="text-end fw-bold fs-6">Total Order Value:</td>
                                <td class="text-end fw-bold text-success fs-5">₹@((Model.TotalAmount > 0 ? Model.TotalAmount : totalAmount).ToString("N2"))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Enterprise Supplier:</span>
                        <strong class="text-dark">Ganesh Enterprises</strong>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Current Status:</span>
                        <strong class="text-dark">@Model.Status</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Consignment Tracking Timeline -->
        @if (Model.TrackingUpdates != null && Model.TrackingUpdates.Any())
        {
            <div class="ge-card shadow-sm border-0 mb-4">
                <div class="ge-card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-truck text-danger me-2"></i>Consignment Milestones &amp; Tracking
                    </h5>
                    <span class="badge bg-danger-subtle text-danger font-monospace">
                        Code: @Model.TrackingUpdates.First().TrackingNumber
                    </span>
                </div>
                <div class="ge-card-body p-4">
                    <ul class="timeline list-unstyled position-relative m-0 ps-3">
                        @foreach (var track in Model.TrackingUpdates.OrderByDescending(t => t.UpdatedAt))
                        {
                            <li class="mb-3 position-relative ps-4" style="border-left: 2px solid #0f766e;">
                                <div class="position-absolute" style="left: -7px; top: 0; width: 12px; height: 12px; border-radius: 50%; background-color: #0f766e;"></div>
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <strong class="text-dark">@track.CurrentStatus</strong>
                                    <small class="text-muted">@track.UpdatedAt.ToString("dd-MMM-yyyy hh:mm tt")</small>
                                </div>
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-geo-alt text-danger me-1"></i>Location: <strong>@track.CurrentLocation</strong>
                                    &bull; Carrier: <strong>@track.CarrierName</strong>
                                </div>
                                @if (!string.IsNullOrEmpty(track.Notes))
                                {
                                    <p class="small text-secondary mb-0 bg-light p-2 rounded">@track.Notes</p>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

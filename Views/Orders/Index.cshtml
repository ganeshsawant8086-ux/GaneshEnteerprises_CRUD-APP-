@model IEnumerable<GaneshEnterprises.Models.Order>

@{
    ViewData["Title"] = "Customer Orders Management";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentStatusFilter = ViewData["CurrentStatusFilter"] as string;
    var currentSort = ViewData["CurrentSort"] as string;
    var statusList = ViewBag.StatusList as string[] ?? new[] { "Pending", "Processing", "Completed", "Cancelled" };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-receipt-cutoff text-primary me-2"></i>Customer Orders Management
        </h2>
        <p class="text-muted small mb-0">
            Track and process plastic bag wholesale and retail orders for Ganesh Enterprises.
        </p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-ge-primary">
            <i class="bi bi-cart-plus me-1"></i> Create New Order
        </a>
    </div>
</div>

<!-- Search & Status Filter Bar -->
<div class="ge-card mb-4">
    <div class="ge-card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <!-- Search Text -->
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@currentSearch" class="form-control border-start-0" 
                           placeholder="Search customer, phone, or bag name..." />
                </div>
            </div>

            <!-- Status Filter Dropdown -->
            <div class="col-md-3">
                <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Order Statuses --</option>
                    @foreach (var status in statusList)
                    {
                        <!option value="@status" @(currentStatusFilter == status ? "selected" : "")>@status Orders</!option>
                    }
                </select>
            </div>

            <!-- Buttons -->
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-semibold px-3">
                    <i class="bi bi-funnel-fill me-1"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentStatusFilter) || !string.IsNullOrEmpty(currentSort))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                        <i class="bi bi-x-circle me-1"></i> Reset
                    </a>
                }
            </div>
        </form>

        <!-- Quick Status Pills -->
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
            <span class="small fw-bold text-muted me-2"><i class="bi bi-filter me-1"></i>Status:</span>
            <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(currentStatusFilter) ? "btn-dark" : "btn-light border")">
                All
            </a>
            <a asp-action="Index" asp-route-statusFilter="Pending" asp-route-searchString="@currentSearch" class="btn btn-sm @(currentStatusFilter == "Pending" ? "btn-warning text-dark" : "btn-outline-warning")">
                Pending
            </a>
            <a asp-action="Index" asp-route-statusFilter="Processing" asp-route-searchString="@currentSearch" class="btn btn-sm @(currentStatusFilter == "Processing" ? "btn-primary" : "btn-outline-primary")">
                Processing
            </a>
            <a asp-action="Index" asp-route-statusFilter="Completed" asp-route-searchString="@currentSearch" class="btn btn-sm @(currentStatusFilter == "Completed" ? "btn-success" : "btn-outline-success")">
                Completed
            </a>
            <a asp-action="Index" asp-route-statusFilter="Cancelled" asp-route-searchString="@currentSearch" class="btn btn-sm @(currentStatusFilter == "Cancelled" ? "btn-danger" : "btn-outline-danger")">
                Cancelled
            </a>
        </div>
    </div>
</div>

<!-- Orders Table -->
<div class="ge-card">
    <div class="ge-card-header">
        <div>
            <h5 class="mb-0 fw-bold text-dark">Order Transactions</h5>
            <small class="text-muted">Total @Model.Count() customer record(s)</small>
        </div>
    </div>
    <div class="table-responsive">
        <table class="ge-table table-hover">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["CustomerSortParam"]" asp-route-searchString="@currentSearch" asp-route-statusFilter="@currentStatusFilter">
                            Customer / Contact <i class="bi bi-arrow-down-up small text-muted"></i>
                        </a>
                    </th>
                    <th>Plastic Bag Product</th>
                    <th>Bag Size</th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["QtySortParam"]" asp-route-searchString="@currentSearch" asp-route-statusFilter="@currentStatusFilter">
                            Quantity <i class="bi bi-arrow-down-up small text-muted"></i>
                        </a>
                    </th>
                    <th>Total Value</th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]" asp-route-searchString="@currentSearch" asp-route-statusFilter="@currentStatusFilter">
                            Order Date <i class="bi bi-arrow-down-up small text-muted"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["StatusSortParam"]" asp-route-searchString="@currentSearch" asp-route-statusFilter="@currentStatusFilter">
                            Status <i class="bi bi-arrow-down-up small text-muted"></i>
                        </a>
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var order in Model)
                    {
                        var totalAmount = order.TotalAmount > 0 ? order.TotalAmount : (order.Product != null ? order.Product.Price * order.Quantity : 0);
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@order.Id" class="fw-bold text-primary">#@order.Id</a>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@order.CustomerName</div>
                                <small class="text-muted"><i class="bi bi-telephone me-1"></i>@order.ContactNumber</small>
                            </td>
                            <td>
                                @if (order.OrderItems != null && order.OrderItems.Count > 1)
                                {
                                    <div class="fw-semibold text-dark">
                                        @order.OrderItems.First().ProductName
                                        <span class="badge bg-primary-subtle text-primary border ms-1">+@(order.OrderItems.Count - 1) more</span>
                                    </div>
                                    <small class="text-muted">@order.OrderItems.Count bag products in order</small>
                                }
                                else if (order.Product != null)
                                {
                                    <div class="fw-semibold text-dark">@order.Product.Name</div>
                                    <small class="text-muted">₹@order.Product.Price.ToString("F2") / pc</small>
                                }
                                else
                                {
                                    <span class="text-muted">Item #@order.ProductId</span>
                                }
                            </td>
                            <td>
                                @if (order.Product != null)
                                {
                                    @if (order.Product.BagSize == GaneshEnterprises.Models.BagSize.Small)
                                    {
                                        <span class="badge-bag-small">Small</span>
                                    }
                                    else if (order.Product.BagSize == GaneshEnterprises.Models.BagSize.Medium)
                                    {
                                        <span class="badge-bag-medium">Medium</span>
                                    }
                                    else
                                    {
                                        <span class="badge-bag-large">Large</span>
                                    }
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@order.Quantity.ToString("N0")</span>
                                <small class="text-muted d-block">pcs</small>
                            </td>
                            <td>
                                <span class="fw-bold text-success fs-6">₹@totalAmount.ToString("N2")</span>
                            </td>
                            <td>
                                <div>@order.OrderDate.ToString("dd-MMM-yyyy")</div>
                            </td>
                            <td>
                                @if (order.Status == "Pending")
                                {
                                    <span class="badge-status-pending">Pending</span>
                                }
                                else if (order.Status == "Processing")
                                {
                                    <span class="badge-status-processing">Processing</span>
                                }
                                else if (order.Status == "Completed")
                                {
                                    <span class="badge-status-completed">Completed</span>
                                }
                                else
                                {
                                    <span class="badge-status-cancelled">@order.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-light border" title="View Order Slip">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-light border text-primary" title="Edit Order">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-light border text-danger" title="Delete Order">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                <h5 class="fw-bold text-dark">No Orders Found</h5>
                                <p class="small text-muted mb-3">No orders match the current filter criteria.</p>
                                <a asp-action="Index" class="btn btn-outline-primary btn-sm me-2">Clear Filter</a>
                                <a asp-action="Create" class="btn btn-primary btn-sm">Create New Order</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

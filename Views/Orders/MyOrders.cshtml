@model IEnumerable<GaneshEnterprises.Models.Order>

@{
    ViewData["Title"] = "My Orders & Tracking - Ganesh Enterprises";
    var customerPhone = ViewBag.CustomerPhone as string ?? "";
    var customerName = ViewBag.CustomerName as string ?? "Customer";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold px-3 py-1 rounded-pill">
                <i class="bi bi-shield-check me-1"></i> Customer Private Session
            </span>
            <span class="badge bg-light text-dark border fw-bold px-3 py-1 rounded-pill">
                <i class="bi bi-phone me-1"></i> +91 @customerPhone
            </span>
        </div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-receipt-cutoff text-primary me-2"></i>My Orders &amp; Consignment Tracking
        </h2>
        <p class="text-muted small mb-0">
            Welcome, <strong>@customerName</strong>. Here are all orders placed under your mobile number (+91 @customerPhone).
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
            <i class="bi bi-boxes me-1"></i> Product Catalog
        </a>
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary btn-sm fw-bold">
            <i class="bi bi-cart-plus-fill me-1"></i> Place New Order
        </a>
    </div>
</div>

<!-- Privacy Reminder Banner -->
<div class="alert alert-light border border-success-subtle shadow-sm mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2" role="alert">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-shield-lock-fill text-success fs-5"></i>
        <small class="text-muted">
            <strong class="text-dark">Data Isolation Protected:</strong> Only orders linked to mobile number <code>+91 @customerPhone</code> are visible in your portal.
        </small>
    </div>
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        <button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-arrow-right me-1"></i> Switch Mobile Number / Logout
        </button>
    </form>
</div>

@if (Model != null && Model.Any())
{
    <div class="ge-card shadow-sm border-0">
        <div class="ge-card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0 fw-bold text-dark">Order History (@Model.Count())</h5>
                <small class="text-muted">Real-time status and consignment tracking for each order</small>
            </div>
        </div>
        <div class="table-responsive">
            <table class="ge-table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Order Date</th>
                        <th>Bag Product &amp; Specification</th>
                        <th>Size</th>
                        <th>Quantity</th>
                        <th>Total Value</th>
                        <th>Status</th>
                        <th>Latest Tracking Update</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var totalAmount = order.TotalAmount > 0 ? order.TotalAmount : (order.Product != null ? order.Product.Price * order.Quantity : 0);
                        var latestTracking = order.TrackingUpdates?.OrderByDescending(t => t.UpdatedAt).FirstOrDefault();

                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@order.Id" class="fw-bold text-primary font-monospace text-decoration-none">
                                    @(order.OrderNumber ?? $"#GE-{order.Id}")
                                </a>
                            </td>
                            <td>
                                <div class="text-dark small fw-semibold">@order.OrderDate.ToString("dd-MMM-yyyy")</div>
                            </td>
                            <td>
                                @if (order.OrderItems != null && order.OrderItems.Count > 1)
                                {
                                    <div class="fw-bold text-dark">
                                        @order.OrderItems.First().ProductName
                                        <span class="badge bg-primary-subtle text-primary border ms-1">+@(order.OrderItems.Count - 1) more</span>
                                    </div>
                                    <small class="text-muted">@order.OrderItems.Count bag products</small>
                                }
                                else if (order.Product != null)
                                {
                                    <div class="fw-bold text-dark">@order.Product.Name</div>
                                    <small class="text-muted">Rate: ₹@order.Product.Price.ToString("F2") / pc</small>
                                }
                                else
                                {
                                    <span class="text-muted">Item #@order.ProductId</span>
                                }
                            </td>
                            <td>
                                @if (order.Product != null)
                                {
                                    @if (order.Product.BagSize == GaneshEnterprises.Models.BagSize.Small)
                                    {
                                        <span class="badge-bag-small">Small</span>
                                    }
                                    else if (order.Product.BagSize == GaneshEnterprises.Models.BagSize.Medium)
                                    {
                                        <span class="badge-bag-medium">Medium</span>
                                    }
                                    else
                                    {
                                        <span class="badge-bag-large">Large</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Standard</span>
                                }
                            </td>
                            <td>
                                <strong class="text-dark">@order.Quantity.ToString("N0")</strong>
                                <small class="text-muted d-block">pcs</small>
                            </td>
                            <td>
                                <span class="fw-bold text-success fs-6">₹@totalAmount.ToString("N2")</span>
                            </td>
                            <td>
                                @if (order.Status == "Pending")
                                {
                                    <span class="badge-status-pending">Pending</span>
                                }
                                else if (order.Status == "Processing")
                                {
                                    <span class="badge-status-processing">Processing</span>
                                }
                                else if (order.Status == "Shipped" || order.Status == "Completed")
                                {
                                    <span class="badge-status-completed">@order.Status</span>
                                }
                                else if (order.Status == "Delivered")
                                {
                                    <span class="badge bg-success text-white">Delivered</span>
                                }
                                else
                                {
                                    <span class="badge-status-cancelled">@order.Status</span>
                                }
                            </td>
                            <td>
                                @if (latestTracking != null)
                                {
                                    <div>
                                        <span class="fw-semibold text-dark small">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@latestTracking.CurrentStatus
                                        </span>
                                        <small class="text-muted d-block">
                                            Carrier: @latestTracking.CarrierName &bull; Code: <code>@latestTracking.TrackingNumber</code>
                                        </small>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Generating milestone...</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary fw-semibold">
                                    <i class="bi bi-receipt me-1"></i> View Slip &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="ge-card shadow-sm border-0 py-5 text-center">
        <div class="p-4">
            <div style="width: 72px; height: 72px; background: rgba(15, 118, 110, 0.1); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                <i class="bi bi-bag-plus text-primary fs-1"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No Orders Found for +91 @customerPhone</h4>
            <p class="text-muted mb-4" style="max-width: 480px; margin: 0 auto;">
                You haven't placed an order yet under this mobile number. Browse our catalog of Small, Medium, and Large plastic bags and place your order today!
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary fw-bold px-4">
                    <i class="bi bi-boxes me-1"></i> Explore Bag Sizes
                </a>
                <a asp-controller="Orders" asp-action="Create" class="btn btn-primary fw-bold px-4">
                    <i class="bi bi-cart-plus me-1"></i> Place Your First Order
                </a>
            </div>
        </div>
    </div>
}

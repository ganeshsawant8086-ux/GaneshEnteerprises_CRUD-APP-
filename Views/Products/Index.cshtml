@model IEnumerable<GaneshEnterprises.Models.Product>

@{
    ViewData["Title"] = "Customer Store - Plastic Bags Catalog (Small • Medium • Large)";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentSizeFilter = ViewData["CurrentSizeFilter"] as GaneshEnterprises.Models.BagSize?;
    var currentSort = ViewData["CurrentSort"] as string;
    var isAdmin = User.IsInRole("Admin");
    var isRetailer = User.IsInRole("Retailer");

    var smallCount = Model.Count(p => p.BagSize == GaneshEnterprises.Models.BagSize.Small);
    var mediumCount = Model.Count(p => p.BagSize == GaneshEnterprises.Models.BagSize.Medium);
    var largeCount = Model.Count(p => p.BagSize == GaneshEnterprises.Models.BagSize.Large);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold px-3 py-1 rounded-pill mb-1">
            <i class="bi bi-cart3 me-1"></i> Customer Store &bull; No Login Required
        </span>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-boxes text-primary me-2"></i>Plastic Bags Product Catalog
        </h2>
        <p class="text-muted small mb-0">
            Browse Ganesh Enterprises' Small, Medium, and Large plastic bags. Transparent retail prices with instant order placement.
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (isAdmin)
        {
            <a asp-controller="Admin" asp-action="Products" class="btn btn-danger btn-sm fw-bold">
                <i class="bi bi-gear-fill me-1"></i> Admin Price Control
            </a>
            <a asp-action="Create" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="bi bi-plus-circle me-1"></i> Add Bag
            </a>
        }
        else if (isRetailer)
        {
            <a asp-controller="RetailerPortal" asp-action="Index" class="btn btn-warning btn-sm text-dark fw-bold">
                <i class="bi bi-tags-fill me-1"></i> View Wholesale Margins
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="RetailerLogin" class="btn btn-outline-warning btn-sm text-dark fw-bold">
                <i class="bi bi-shop me-1"></i> Retailer? View Wholesale Rates
            </a>
        }
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary btn-sm fw-bold">
            <i class="bi bi-cart-plus-fill me-1"></i> Place Order (No Login)
        </a>
    </div>
</div>

@if (isRetailer)
{
    <div class="alert alert-warning border-0 d-flex justify-content-between align-items-center mb-4" role="alert">
        <div>
            <i class="bi bi-info-circle-fill me-2 text-warning"></i>
            <strong>Retailer Partner Notice:</strong> You are currently viewing public customer rates. Switch to your Retailer Portal to view discounted wholesale rates and profit margins.
        </div>
        <a asp-controller="RetailerPortal" asp-action="Index" class="btn btn-sm btn-dark fw-bold">Open Retailer Portal &rarr;</a>
    </div>
}

<!-- Search, Filter & Size Pill Bar -->
<div class="ge-card mb-4 shadow-sm border-0">
    <div class="ge-card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <!-- Search Text -->
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@currentSearch" class="form-control border-start-0" 
                           placeholder="Search bag name, size, material, or description..." />
                </div>
            </div>

            <!-- Size Filter Dropdown -->
            <div class="col-md-3">
                <select name="bagSizeFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Bag Sizes --</option>
                    <!option value="Small" @(currentSizeFilter == GaneshEnterprises.Models.BagSize.Small ? "selected" : "")>Small Bags</!option>
                    <!option value="Medium" @(currentSizeFilter == GaneshEnterprises.Models.BagSize.Medium ? "selected" : "")>Medium Bags</!option>
                    <!option value="Large" @(currentSizeFilter == GaneshEnterprises.Models.BagSize.Large ? "selected" : "")>Large Bags</!option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-semibold px-3">
                    <i class="bi bi-funnel-fill me-1"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentSizeFilter.HasValue || !string.IsNullOrEmpty(currentSort))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                        <i class="bi bi-x-circle me-1"></i> Reset
                    </a>
                }
            </div>
        </form>

        <!-- Quick Size Filter Pills with Item Badges -->
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
            <span class="small fw-bold text-muted me-2"><i class="bi bi-tags me-1"></i>Categories:</span>
            <a asp-action="Index" class="btn btn-sm @(!currentSizeFilter.HasValue ? "btn-dark text-white fw-bold" : "btn-light border")">
                All Categories <span class="badge bg-secondary ms-1">@Model.Count()</span>
            </a>
            <a asp-action="Index" asp-route-bagSizeFilter="Small" asp-route-searchString="@currentSearch" class="btn btn-sm @(currentSizeFilter == GaneshEnterprises.Models.BagSize.Small ? "btn-info text-white fw-bold" : "btn-outline-info")">
                <i class="bi bi-circle-fill me-1 small"></i> Small Bags 
                <span class="badge bg-light text-dark ms-1">@smallCount</span>
            </a>
            <a asp-action="Index" asp-route-bagSizeFilter="Medium" asp-route-searchString="@currentSearch" class="btn btn-sm @(currentSizeFilter == GaneshEnterprises.Models.BagSize.Medium ? "btn-warning text-dark fw-bold" : "btn-outline-warning")">
                <i class="bi bi-circle-fill me-1 small"></i> Medium Bags 
                <span class="badge bg-light text-dark ms-1">@mediumCount</span>
            </a>
            <a asp-action="Index" asp-route-bagSizeFilter="Large" asp-route-searchString="@currentSearch" class="btn btn-sm @(currentSizeFilter == GaneshEnterprises.Models.BagSize.Large ? "btn-primary fw-bold" : "btn-outline-primary")" style="@(currentSizeFilter == GaneshEnterprises.Models.BagSize.Large ? "background-color: #9333ea; border-color: #9333ea;" : "border-color: #9333ea; color: #9333ea;")">
                <i class="bi bi-circle-fill me-1 small"></i> Large Bags 
                <span class="badge bg-light text-dark ms-1">@largeCount</span>
            </a>
        </div>
    </div>
</div>

<!-- Product Table -->
<div class="ge-card shadow-sm border-0">
    <div class="ge-card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 fw-bold text-dark">Plastic Bag Catalog</h5>
            <small class="text-muted">Showing @Model.Count() specifications in catalog</small>
        </div>
    </div>
    <div class="table-responsive">
        <table class="ge-table table-hover align-middle">
            <thead>
                <tr>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-searchString="@currentSearch" asp-route-bagSizeFilter="@currentSizeFilter">
                            Product Name <i class="bi bi-arrow-down-up small text-muted"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["SizeSortParam"]" asp-route-searchString="@currentSearch" asp-route-bagSizeFilter="@currentSizeFilter">
                            Category / Size <i class="bi bi-arrow-down-up small text-muted"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParam"]" asp-route-searchString="@currentSearch" asp-route-bagSizeFilter="@currentSizeFilter">
                            Price / Unit <i class="bi bi-arrow-down-up small text-muted"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["StockSortParam"]" asp-route-searchString="@currentSearch" asp-route-bagSizeFilter="@currentSizeFilter">
                            Stock Units <i class="bi bi-arrow-down-up small text-muted"></i>
                        </a>
                    </th>
                    <th>Availability</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var displayPrice = item.CustomerPrice > 0 ? item.CustomerPrice : item.Price;
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-dark text-decoration-none">
                                    @item.Name
                                </a>
                                <small class="text-muted d-block text-truncate" style="max-width: 380px;" title="@item.Description">
                                    @item.Description
                                </small>
                            </td>
                            <td>
                                @if (item.BagSize == GaneshEnterprises.Models.BagSize.Small)
                                {
                                    <span class="badge-bag-small">Small</span>
                                }
                                else if (item.BagSize == GaneshEnterprises.Models.BagSize.Medium)
                                {
                                    <span class="badge-bag-medium">Medium</span>
                                }
                                else
                                {
                                    <span class="badge-bag-large">Large</span>
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-dark fs-6">₹@displayPrice.ToString("F2")</span>
                                <small class="text-muted d-block">per piece</small>
                            </td>
                            <td>
                                @if (item.StockQuantity > 5000)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                                        @item.StockQuantity.ToString("N0") Units
                                    </span>
                                }
                                else if (item.StockQuantity > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle fw-semibold">
                                        @item.StockQuantity.ToString("N0") Units
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold">
                                        Out of Stock
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i> Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white"><i class="bi bi-pause-circle me-1"></i> Suspended</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-controller="Orders" asp-action="Create" asp-route-productId="@item.Id" 
                                       class="btn btn-sm btn-success fw-semibold" title="Place customer order">
                                        <i class="bi bi-cart-plus"></i> Order
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (isAdmin)
                                    {
                                        <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-primary" title="Edit Pricing">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-danger" title="Delete">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-search fs-1 d-block mb-2 text-secondary"></i>
                                <h5 class="fw-bold text-dark">No Plastic Bags Found</h5>
                                <p class="small text-muted mb-3">No records match your search criteria.</p>
                                <a asp-action="Index" class="btn btn-outline-primary btn-sm me-2">Clear Filters</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
